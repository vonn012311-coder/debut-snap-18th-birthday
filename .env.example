# ============================================================
# SCAN & SNAP – 18th Birthday Edition
# Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.
# ============================================================

# ─── Google Drive Service Account ─────────────────────────
# Get these from your Google Cloud Console service account key JSON

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the private_key value from your service account JSON
# Keep the quotes and \n characters exactly as-is
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"

GOOGLE_PROJECT_ID=your-google-cloud-project-id

# ─── Google Drive Folder ──────────────────────────────────
# The ID of the folder where uploads will be saved
# Find it in the Google Drive folder URL: /folders/FOLDER_ID_HERE
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# ─── Site URL ─────────────────────────────────────────────
# Your Vercel deployment URL (for QR code generation)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
